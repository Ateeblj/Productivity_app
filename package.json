{
  "name": "productivity-app",
  "version": "1.0.0",
  "description": "Offline productivity app with notes, tasks, and planner",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --clear",
    "start:lan": "expo start --lan --clear",
    "start:tunnel": "expo start --tunnel --clear",
    "web": "expo start --web --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild:android": "expo prebuild --clean --platform android",
    "run:android": "expo run:android",
    "start:dev-client": "expo start --dev-client",
    "electron": "electron main.js",
    "export:web": "expo export --platform web",
    "electron:dev": "npm run export:web && electron main.js",
    "build:desktop": "npm run export:web && electron-builder --config.extraMetadata.main=main.js",
    "build:desktop:win": "npm run export:web && electron-builder --win --config.extraMetadata.main=main.js",
    "build:desktop:mac": "npm run export:web && electron-builder --mac --config.extraMetadata.main=main.js",
    "build:desktop:linux": "npm run export:web && electron-builder --linux --config.extraMetadata.main=main.js",
    "build:mobile:android": "eas build -p android --profile preview",
    "build:mobile:ios": "eas build -p ios --profile preview"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/drawer": "^7.12.8",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@supabase/supabase-js": "2.108.1",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.13",
    "expo-av": "~16.0.8",
    "expo-camera": "~17.0.10",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-notifications": "~0.32.17",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "express": "^5.2.1",
    "nativewind": "^4.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1307.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "tailwindcss": "^3.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "electron-packager": "^17.1.2",
    "typescript": "~5.9.2"
  },
  "build": {
    "npmRebuild": false,
    "appId": "com.ateeb.productivityapp",
    "productName": "Productivity App",
    "copyright": "Copyright © Productivity App",
    "extraMetadata": {
      "main": "main.js"
    },
    "directories": {
      "output": "dist-electron",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "dist/**/*",
      "assets/icon.png",
      "assets/favicon.png"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Productivity App"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Office"
    },
    "asarUnpack": [
      "dist/**/*"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "overrides": {},
  "resolutions": {},
  "expo": {
    "install": {
      "exclude": [
        "react-native-reanimated",
        "react-native-worklets"
      ]
    }
  }
}
